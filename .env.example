# Скопируйте в .env: значения для локального запуска, в проде заменить.
POSTGRES_PASSWORD=postgres
MLFLOW_DB_PASSWORD=mlflow
S3_ACCESS_KEY=mlflowaccess
S3_SECRET_KEY=mlflowsecret123
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

APP_PORT=8000
POSTGRES_PORT=5433
MLFLOW_PORT=5001
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
S3_CONSOLE_PORT=9001

# Параметры конвейера (ДЗ4)
QUEUE_NAME=scoring.tasks
QUEUE_MAX_LENGTH=200
WORKER_CONCURRENCY=4
INFERENCE_DELAY_SECONDS=0.2
SOURCE_MAX_TASKS=30000
SOURCE_BATCH_ID=batch-1
MODEL_ALIAS=champion
